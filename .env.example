# claw-reflect environment variables
# Copy to .env and fill in values before running

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
REFLECT_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/claw_reflect
REFLECT_DATABASE_POOL_SIZE=10
REFLECT_DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REFLECT_REDIS_URL=redis://localhost:6379/0
REFLECT_CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
REFLECT_LLM_PROVIDER=anthropic
REFLECT_LLM_MODEL=claude-sonnet-4-20250514
REFLECT_LLM_API_KEY=sk-ant-CHANGEME
REFLECT_LLM_BASE_URL=
REFLECT_LLM_MAX_TOKENS=2048
REFLECT_LLM_TIMEOUT_SECS=30.0
REFLECT_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Reflection job settings
# ---------------------------------------------------------------------------
REFLECT_REFLECTION_BATCH_SIZE=50
REFLECT_REFLECTION_INTERVAL_MINUTES=30
REFLECT_DECAY_INTERVAL_HOURS=6
REFLECT_SCORE_REFRESH_INTERVAL_HOURS=12

# ---------------------------------------------------------------------------
# Scoring weights
# ---------------------------------------------------------------------------
REFLECT_IMPORTANCE_WEIGHT=0.4
REFLECT_RECENCY_WEIGHT=0.35
REFLECT_CONFIDENCE_WEIGHT=0.25

# ---------------------------------------------------------------------------
# Decay
# ---------------------------------------------------------------------------
REFLECT_DEFAULT_DECAY_POLICY=exponential
REFLECT_DECAY_HALF_LIFE_DAYS=30.0
REFLECT_ARCHIVE_THRESHOLD_SCORE=0.05
REFLECT_MIN_SCORE_TO_KEEP=0.02

# ---------------------------------------------------------------------------
# Duplication
# ---------------------------------------------------------------------------
REFLECT_DUPLICATE_SIMILARITY_THRESHOLD=0.92

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
REFLECT_API_HOST=0.0.0.0
REFLECT_API_PORT=8090
REFLECT_DEBUG=false
REFLECT_LOG_LEVEL=INFO
REFLECT_LOG_FORMAT=json
